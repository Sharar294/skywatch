{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "SkyWatch-Ops Overview",
  "tags": ["skywatch"],
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Airborne Flights (latest batch)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "targets": [ { "expr": "skywatch_analyzer_airborne_flights", "legendFormat": "airborne" } ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Anomaly Ratio (latest batch)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.02 }, { "color": "red", "value": 0.1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "skywatch_analyzer_anomaly_ratio", "legendFormat": "anomaly ratio" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flights Processed / min",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "rate(skywatch_analyzer_flights_processed_total[5m]) * 60", "legendFormat": "flights/min" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Batches Consumed / min",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "rate(skywatch_analyzer_batches_total[5m]) * 60", "legendFormat": "batches/min" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Anomalies by Reason (rate/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "expr": "rate(skywatch_analyzer_anomalies_total[5m]) * 60", "legendFormat": "{{reason}}" } ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Batch Mean Velocity & Altitude",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [ { "matcher": { "id": "byName", "options": "mean altitude (m)" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "targets": [
        { "expr": "skywatch_analyzer_mean_velocity_mps", "legendFormat": "mean velocity (m/s)" },
        { "expr": "skywatch_analyzer_mean_altitude_m", "legendFormat": "mean altitude (m)" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API Requests (rate/min by endpoint)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "expr": "rate(skywatch_api_requests_total[5m]) * 60", "legendFormat": "{{endpoint}} {{method}}" } ]
    }
  ]
}
