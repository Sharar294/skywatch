# SkyWatch-Ops environment configuration
# Copy this file to configs/.env and fill in your real values:
#   cp configs/.env.example configs/.env
#
# configs/.env is gitignored (it holds secrets) and is required by the
# `api` and `worker` services in docker-compose.yml.

# --- OpenSky Network API (OAuth2 client credentials) ---
# Create an API client at https://opensky-network.org/ (account → API clients)
OPENSKY_CLIENT_ID=your-client-id-here
OPENSKY_CLIENT_SECRET=your-client-secret-here

# --- Infrastructure addresses ---
# These match the docker-compose service names; override only if you change them.
REDIS_ADDR=redis-service:6379
KAFKA_BROKERS=kafka:9092
